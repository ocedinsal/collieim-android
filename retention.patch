+  <string name="ChatsSettingsFragment__keep_view_once_messages">Keep view-once media</string>
+  <string name="ChatsSettingsFragment__keep_view_once_messages_summary">Keep received view-once media after viewing. Redacted sent copies contain no media to keep. Kept media may appear in backups and exports, including on another device after restore. Turning this off does not delete messages or media already kept.</string>
